enable_testing()
find_package(Threads REQUIRED)
set(HOST_SERVICES runtime/src/host/platform.cpp runtime/src/host/thread.cpp runtime/src/host/timing.cpp)
add_executable(host_file_test runtime/tests/host_file_test.cpp runtime/src/host/file.cpp)
add_executable(host_values_test runtime/tests/host_values_test.cpp)
add_executable(host_settings_test runtime/tests/host_settings_test.cpp runtime/src/gpu/settings.cpp)
add_executable(host_platform_test runtime/tests/host_platform_test.cpp ${HOST_SERVICES})
add_executable(host_kernel_test runtime/tests/host_kernel_test.cpp ${HOST_SERVICES}
    runtime/src/kernel/kernel.cpp runtime/src/kernel/memory.cpp runtime/src/threads.cpp)
add_library(host_interp_compile OBJECT runtime/src/interp/camera.cpp runtime/src/interp/frame_probe.cpp
    runtime/src/interp/interp_draw.cpp runtime/src/service/ipc.cpp runtime/src/video/host1x.cpp)
# Compile the SVC integration as well; its IPC/core symbols are supplied by the game runtime.
add_library(host_svc_compile OBJECT runtime/src/kernel/svc.cpp)
add_library(host_service_compile OBJECT runtime/src/service/applet.cpp runtime/src/service/misc.cpp)
add_library(host_nvdrv_compile OBJECT runtime/src/gpu/nvdrv.cpp)
target_include_directories(host_service_compile PRIVATE third_party/vulkan-headers/include)
target_include_directories(host_nvdrv_compile PRIVATE third_party/vulkan-headers/include)
foreach(target host_platform_test host_kernel_test host_file_test host_values_test host_settings_test host_svc_compile host_interp_compile host_service_compile host_nvdrv_compile)
    target_include_directories(${target} PRIVATE runtime/src runtime/include)
    target_link_libraries(${target} PRIVATE Threads::Threads)
    if(MSVC)
        target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_compile_options(${target} PRIVATE /EHsc /W4)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra)
    endif()
endforeach()
if(MSVC)
    # Match the runtime's fixed host image base: ASLR can occupy the 39-bit guest layout.
    target_link_options(host_kernel_test PRIVATE /DYNAMICBASE:NO /FIXED:NO)
endif()
add_test(NAME host_platform COMMAND host_platform_test)
add_test(NAME host_kernel COMMAND host_kernel_test)
add_test(NAME host_file COMMAND host_file_test)
add_test(NAME host_values_utc COMMAND host_values_test UTC0 0)
add_test(NAME host_values_west COMMAND host_values_test EST5 -18000)
add_test(NAME host_values_east COMMAND host_values_test JST-9 32400)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/settings-test")
add_test(NAME host_settings COMMAND host_settings_test)
set_tests_properties(host_settings PROPERTIES WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/settings-test")
set_tests_properties(host_platform host_kernel host_file host_values_utc host_values_west host_values_east host_settings PROPERTIES TIMEOUT 30)
add_custom_target(host_tests DEPENDS host_platform_test host_kernel_test host_file_test host_values_test host_settings_test host_svc_compile host_interp_compile host_service_compile host_nvdrv_compile)
