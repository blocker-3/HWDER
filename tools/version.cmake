# Writes the build's version header: cmake -DSRC=<checkout> -DOUT=<header> -P tools/version.cmake
# Run on every build; the header is rewritten only when its content changes, so an unchanged
# build does not recompile version.cpp.
set(version "unknown")
set(commit "unknown")
# A setup kit has no .git; make_setup_dist.py writes version.txt (version, then commit) into its source.
if(EXISTS "${SRC}/version.txt")
    file(STRINGS "${SRC}/version.txt" stamp LIMIT_COUNT 2)
    list(LENGTH stamp n)
    if(n EQUAL 2)
        list(GET stamp 0 version)
        list(GET stamp 1 commit)
    endif()
else()
    find_package(Git QUIET)
endif()
if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} describe --tags --match "v*" --always --dirty WORKING_DIRECTORY ${SRC}
                    OUTPUT_VARIABLE out RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0 AND out)
        set(version "${out}")
    endif()
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short=10 HEAD WORKING_DIRECTORY ${SRC}
                    OUTPUT_VARIABLE out RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0 AND out)
        set(commit "${out}")
    endif()
endif()
string(TIMESTAMP date "%Y-%m-%d")

set(text "// Generated by tools/version.cmake at build time. Do not edit.
#pragma once
#define HWDER_VERSION \"${version}\"
#define HWDER_COMMIT \"${commit}\"
#define HWDER_BUILD_DATE \"${date}\"
")
set(old "")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
