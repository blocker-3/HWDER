// HWDER Setup.exe resources: icon, application manifest and the version information Explorer
// shows under Properties > Details. The version is Setup's own (setup_version.h), not the release's.
#include <winver.h>
#include "setup_version.h"

1 ICON "hwder.ico"
1 24 "bootstrap.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION HWDER_SETUP_VERSION_MAJOR,HWDER_SETUP_VERSION_MINOR,HWDER_SETUP_VERSION_PATCH,0
PRODUCTVERSION HWDER_SETUP_VERSION_MAJOR,HWDER_SETUP_VERSION_MINOR,HWDER_SETUP_VERSION_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "HWDER project"
            VALUE "FileDescription", "HWDER Setup"
            VALUE "FileVersion", HWDER_SETUP_VERSION
            VALUE "InternalName", "HWDER Setup"
            VALUE "LegalCopyright", "HWDER contributors. MIT License."
            VALUE "OriginalFilename", "HWDER Setup.exe"
            VALUE "ProductName", "HWDER"
            VALUE "ProductVersion", HWDER_SETUP_VERSION
            VALUE "Comments", "Sets up HWDER from your own game dump. https://github.com/blocker-3/HWDER"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
