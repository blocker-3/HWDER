// FXAA + contrast-adaptive sharpening on the game's tonemapped 3D picture (Graphics > Picture).
// Runs once per frame right after the final tonemap pass, before the HUD is drawn over it.
// Compiled to post_spv.h by tools/compile_post.py (needs glslc from the Vulkan SDK); the build uses
// the checked-in header, so only edits to this file need glslc.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D src;      // copy of the picture, linear filtering
layout(binding = 1, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform PC {
    vec2 inv_size;  // 1 / picture size
    float fxaa;     // 1 = FXAA on
    float sharpen;  // 0..1 CAS strength (0 = off)
} pc;

float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

// FXAA 3.11 (quality preset 12-ish, Timothy Lottes), condensed.
vec3 fxaa(vec2 uv) {
    vec2 px = pc.inv_size;
    vec3 rgbM = texture(src, uv).rgb;
    float lM = luma(rgbM);
    float lN = luma(textureLodOffset(src, uv, 0.0, ivec2(0, -1)).rgb);
    float lS = luma(textureLodOffset(src, uv, 0.0, ivec2(0, 1)).rgb);
    float lE = luma(textureLodOffset(src, uv, 0.0, ivec2(1, 0)).rgb);
    float lW = luma(textureLodOffset(src, uv, 0.0, ivec2(-1, 0)).rgb);
    float mx = max(lM, max(max(lN, lS), max(lE, lW)));
    float mn = min(lM, min(min(lN, lS), min(lE, lW)));
    float range = mx - mn;
    if (range < max(0.0312, mx * 0.125)) return rgbM;
    float lNW = luma(textureLodOffset(src, uv, 0.0, ivec2(-1, -1)).rgb);
    float lNE = luma(textureLodOffset(src, uv, 0.0, ivec2(1, -1)).rgb);
    float lSW = luma(textureLodOffset(src, uv, 0.0, ivec2(-1, 1)).rgb);
    float lSE = luma(textureLodOffset(src, uv, 0.0, ivec2(1, 1)).rgb);
    float edgeH = abs(lNW + lNE - 2.0 * lN) + 2.0 * abs(lW + lE - 2.0 * lM) + abs(lSW + lSE - 2.0 * lS);
    float edgeV = abs(lNW + lSW - 2.0 * lW) + 2.0 * abs(lN + lS - 2.0 * lM) + abs(lNE + lSE - 2.0 * lE);
    bool horz = edgeH >= edgeV;
    float l1 = horz ? lN : lW, l2 = horz ? lS : lE;
    float g1 = abs(l1 - lM), g2 = abs(l2 - lM);
    bool steep1 = g1 >= g2;
    float gscaled = 0.25 * max(g1, g2);
    float step_len = horz ? px.y : px.x;
    float llocal;
    if (steep1) { step_len = -step_len; llocal = 0.5 * (l1 + lM); } else { llocal = 0.5 * (l2 + lM); }
    vec2 cuv = uv;
    if (horz) cuv.y += step_len * 0.5; else cuv.x += step_len * 0.5;
    vec2 off = horz ? vec2(px.x, 0.0) : vec2(0.0, px.y);
    vec2 uv1 = cuv - off, uv2 = cuv + off;
    float e1 = luma(textureLod(src, uv1, 0.0).rgb) - llocal;
    float e2 = luma(textureLod(src, uv2, 0.0).rgb) - llocal;
    bool r1 = abs(e1) >= gscaled, r2 = abs(e2) >= gscaled;
    const float steps[10] = float[](1.0, 1.0, 1.0, 1.0, 1.5, 2.0, 2.0, 2.0, 4.0, 8.0);
    for (int i = 0; i < 10 && !(r1 && r2); i++) {
        if (!r1) { uv1 -= off * steps[i]; e1 = luma(textureLod(src, uv1, 0.0).rgb) - llocal; r1 = abs(e1) >= gscaled; }
        if (!r2) { uv2 += off * steps[i]; e2 = luma(textureLod(src, uv2, 0.0).rgb) - llocal; r2 = abs(e2) >= gscaled; }
    }
    float d1 = horz ? uv.x - uv1.x : uv.y - uv1.y;
    float d2 = horz ? uv2.x - uv.x : uv2.y - uv.y;
    bool near1 = d1 < d2;
    float dmin = min(d1, d2);
    float span = d1 + d2;
    bool lMsmaller = lM < llocal;
    bool correct = ((near1 ? e1 : e2) < 0.0) != lMsmaller;
    float pixoff = correct ? -dmin / span + 0.5 : 0.0;
    float lavg = (1.0 / 12.0) * (2.0 * (lN + lS + lE + lW) + lNW + lNE + lSW + lSE);
    float sub1 = clamp(abs(lavg - lM) / range, 0.0, 1.0);
    float sub2 = (-2.0 * sub1 + 3.0) * sub1 * sub1;
    float subpix = sub2 * sub2 * 0.75;
    pixoff = max(pixoff, subpix);
    vec2 fuv = uv;
    if (horz) fuv.y += pixoff * step_len; else fuv.x += pixoff * step_len;
    return textureLod(src, fuv, 0.0).rgb;
}

// AMD FidelityFX CAS (contrast-adaptive sharpening), single-pass, no scaling.
vec3 cas(vec2 uv, vec3 c) {
    vec3 a = textureLodOffset(src, uv, 0.0, ivec2(-1, -1)).rgb;
    vec3 b = textureLodOffset(src, uv, 0.0, ivec2(0, -1)).rgb;
    vec3 cc = textureLodOffset(src, uv, 0.0, ivec2(1, -1)).rgb;
    vec3 d = textureLodOffset(src, uv, 0.0, ivec2(-1, 0)).rgb;
    vec3 f = textureLodOffset(src, uv, 0.0, ivec2(1, 0)).rgb;
    vec3 g = textureLodOffset(src, uv, 0.0, ivec2(-1, 1)).rgb;
    vec3 h = textureLodOffset(src, uv, 0.0, ivec2(0, 1)).rgb;
    vec3 i = textureLodOffset(src, uv, 0.0, ivec2(1, 1)).rgb;
    vec3 mn = min(min(min(d, c), min(f, b)), h);
    vec3 mn2 = min(mn, min(min(a, cc), min(g, i)));
    mn += mn2;
    vec3 mx = max(max(max(d, c), max(f, b)), h);
    vec3 mx2 = max(mx, max(max(a, cc), max(g, i)));
    mx += mx2;
    vec3 amp = clamp(min(mn, 2.0 - mx) / max(mx, 1e-5), 0.0, 1.0);
    amp = sqrt(amp);
    float peak = -1.0 / mix(8.0, 5.0, pc.sharpen);
    vec3 w = amp * peak;
    vec3 rcpw = 1.0 / (1.0 + 4.0 * w);
    return clamp((b * w + d * w + f * w + h * w + c) * rcpw, 0.0, 1.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 uv = (vec2(p) + 0.5) * pc.inv_size;
    vec4 orig = textureLod(src, uv, 0.0);
    vec3 c = pc.fxaa > 0.5 ? fxaa(uv) : orig.rgb;
    if (pc.sharpen > 0.0) c = cas(uv, c);
    imageStore(dst, p, vec4(c, orig.a));
}
