@echo off
rem 120 fps stage b: the game draws an extra in-between frame per tick (blended camera), display locked to 120. Runs this worktree's build against the installed game's NSP and keys (pointed at, never copied).
rem Settings (including the picked paths) are saved in build\release\hwder_settings.ini, never the installed copy.
set HWDER_NSP=C:\Programs\QuiverLauncher-win-Portable\Apps\HyruleWarriorsDefinitiveEdition-HyruleWarriorsDefinitiveEditionRecompHWDER\Hyrule Warriors Definitive Edition.nsp
set HWDER_KEYS=C:\Programs\QuiverLauncher-win-Portable\Apps\HyruleWarriorsDefinitiveEdition-HyruleWarriorsDefinitiveEditionRecompHWDER\prod.keys
set HWDER_GAME_INTERP=1
set HWDER_FPS=120
set HWDER_GI_LOG=1
rem Autoplay runs (HWDER_AUTOPLAY set) start from the fixed test save in ..\test-saves\autoplay instead of the newest played save; backs up first.
if defined HWDER_AUTOPLAY (powershell -NoProfile -Command "$rel='save\0100AE00096EA000\48574445525F55530000000000000001'; $me=[IO.Path]::GetFullPath('%~dp0build\release'); $src=[IO.Path]::GetFullPath('%~dp0..\test-saves\autoplay\0100AE00096EA000\48574445525F55530000000000000001'); $note=Join-Path $me 'autoplay_restore.txt'; Remove-Item $note -ErrorAction SilentlyContinue; if (-not (Test-Path (Join-Path $src 'zmha.bin'))) { Write-Host ('Autoplay: fixed save missing: ' + $src); exit 1 }; if (Test-Path (Join-Path $me 'save')) { $bak=Join-Path $me ('save.bak-' + (Get-Date -Format yyyyMMdd-HHmmss)); Copy-Item (Join-Path $me 'save') $bak -Recurse; Set-Content $note $bak }; New-Item -ItemType Directory -Force (Join-Path $me $rel) | Out-Null; Copy-Item (Join-Path $src 'zmha.bin'),(Join-Path $src 'zmhasd.bin') (Join-Path $me $rel) -Force; Write-Host ('Autoplay: save copied from ' + $src)" & goto :run)
rem Start from the newest save (installed game or a sibling worktree's build), unless this build's own save is as new; backs up first.
powershell -NoProfile -Command "$rel='save\0100AE00096EA000\48574445525F55530000000000000001'; $me=[IO.Path]::GetFullPath('%~dp0build\release'); $roots=@('C:\Programs\QuiverLauncher-win-Portable\Apps\HyruleWarriorsDefinitiveEdition-HyruleWarriorsDefinitiveEditionRecompHWDER') + (git -C '%~dp0.' worktree list --porcelain | Where-Object { $_ -like 'worktree *' } | ForEach-Object { [IO.Path]::GetFullPath(($_.Substring(9) -replace '/','\') + '\build\release') } | Where-Object { $_ -ne $me }); $new=$roots | ForEach-Object { Get-Item (Join-Path $_ \"$rel\zmha.bin\") -ErrorAction SilentlyContinue } | Sort-Object LastWriteTime -Descending | Select-Object -First 1; $own=Get-Item (Join-Path $me \"$rel\zmha.bin\") -ErrorAction SilentlyContinue; if ($new -and (-not $own -or $new.LastWriteTime -gt $own.LastWriteTime)) { if (Test-Path \"$me\save\") { Copy-Item \"$me\save\" (\"$me\save.bak-\" + (Get-Date -Format yyyyMMdd-HHmmss)) -Recurse }; New-Item -ItemType Directory -Force (Join-Path $me $rel) | Out-Null; Copy-Item (Join-Path $new.DirectoryName 'zmha.bin'),(Join-Path $new.DirectoryName 'zmhasd.bin') (Join-Path $me $rel) -Force; Write-Host ('Save copied from ' + $new.DirectoryName) } else { Write-Host 'Save: this build already has the newest' }"
:run
cd /d "%~dp0build\release"
"%~dp0build\release\hwder.exe" %*
rem Autoplay runs: put back the save from before the run (the run's own save is kept as save_after_autoplay-<stamp>), so the newest-save scan never picks it up.
if defined HWDER_AUTOPLAY powershell -NoProfile -Command "$me=[IO.Path]::GetFullPath('%~dp0build\release'); $note=Join-Path $me 'autoplay_restore.txt'; $cur=Join-Path $me 'save'; $stamp=Get-Date -Format yyyyMMdd-HHmmss; if (Test-Path $cur) { Rename-Item $cur ('save_after_autoplay-' + $stamp) }; if (Test-Path $note) { $bak=(Get-Content $note -TotalCount 1).Trim(); Copy-Item $bak $cur -Recurse; Remove-Item $note; Write-Host ('Autoplay: save restored from ' + $bak) } else { Write-Host ('Autoplay: there was no save before the run; its save is in save_after_autoplay-' + $stamp) }"
pause
